{
  "name": "looker-bi-gym",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "bun run --filter @looker-bi-gym/app dev",
    "build": "bun run --filter @looker-bi-gym/app build",
    "check": "bun run --filter @looker-bi-gym/app check",
    "lint": "bun run --filter @looker-bi-gym/app lint",
    "test:quiz": "bun run --filter @looker-bi-gym/app test:quiz",
    "test:sql": "bun run --filter @looker-bi-gym/app test:sql",
    "test:fixtures": "bun run --filter @looker-bi-gym/app test:fixtures",
    "test:cloud-evidence": "bun run --filter @looker-bi-gym/app test:cloud-evidence",
    "test:progress-export": "bun run --filter @looker-bi-gym/app test:progress-export",
    "test:content-qa": "bun run --filter @looker-bi-gym/app test:content-qa",
    "test:e2e": "bun run --filter @looker-bi-gym/app test:e2e",
    "test:validators": "bun run --filter @looker-bi-gym/app test:validators",
    "validate:datasets": "bun run --filter @looker-bi-gym/app validate:datasets",
    "validate:manifests": "bun run --filter @looker-bi-gym/app validate:manifests",
    "validate:static-links": "bun run --filter @looker-bi-gym/app validate:static-links",
    "typecheck": "bun run --filter @looker-bi-gym/app typecheck",
    "preview": "bun run --filter @looker-bi-gym/app preview"
  }
}
