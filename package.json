{
  "name": "looker-bi-gym",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "app",
    "facts-db-app"
  ],
  "scripts": {
    "dev": "bun run --filter @looker-bi-gym/app dev",
    "build": "bun run --filter @looker-bi-gym/app build",
    "content:generate": "bun run --filter @looker-bi-gym/app content:generate",
    "content:check": "bun run --filter @looker-bi-gym/app content:check",
    "check": "bun run --filter facts-db-app typecheck && bun run --filter @looker-bi-gym/app check",
    "lint": "bun run --filter @looker-bi-gym/app lint",
    "format": "bun run --filter @looker-bi-gym/app format",
    "format:check": "bun run --filter @looker-bi-gym/app format:check",
    "test:quiz": "bun run --filter @looker-bi-gym/app test:quiz",
    "test:sql": "bun run --filter @looker-bi-gym/app test:sql",
    "test:fixtures": "bun run --filter @looker-bi-gym/app test:fixtures",
    "test:derived-expectations": "bun run --filter @looker-bi-gym/app test:derived-expectations",
    "test:cloud-evidence": "bun run --filter @looker-bi-gym/app test:cloud-evidence",
    "test:browser-config": "bun run --filter @looker-bi-gym/app test:browser-config",
    "test:progress-export": "bun run --filter @looker-bi-gym/app test:progress-export",
    "test:flashcards": "bun run --filter @looker-bi-gym/app test:flashcards",
    "test:quiz-facts-db": "bun run --filter @looker-bi-gym/app test:quiz-facts-db",
    "test:content-qa": "bun run --filter @looker-bi-gym/app test:content-qa",
    "test:facts-db": "bun run --filter facts-db-app test",
    "test:llm-workbench": "bun run --filter @looker-bi-gym/app test:llm-workbench",
    "sources:snapshot": "bun run --filter @looker-bi-gym/app sources:snapshot",
    "facts:build-db": "bun run --filter facts-db-app build-db",
    "questions:context": "bun run --filter @looker-bi-gym/app questions:context",
    "questions:generate:codex": "bun run --filter @looker-bi-gym/app questions:generate:codex",
    "questions:generate:claude": "bun run --filter @looker-bi-gym/app questions:generate:claude",
    "questions:review:codex": "bun run --filter @looker-bi-gym/app questions:review:codex",
    "questions:review:claude": "bun run --filter @looker-bi-gym/app questions:review:claude",
    "dream:prompt": "bun run --filter @looker-bi-gym/app dream:prompt",
    "dream:codex": "bun run --filter @looker-bi-gym/app dream:codex",
    "dream:claude": "bun run --filter @looker-bi-gym/app dream:claude",
    "test:platform-boundary": "bun run --filter @looker-bi-gym/app test:platform-boundary",
    "test:e2e": "bun run --filter @looker-bi-gym/app test:e2e",
    "verify:deployed-surface": "bun run --filter @looker-bi-gym/app verify:deployed-surface",
    "test:validators": "bun run --filter @looker-bi-gym/app test:validators",
    "validate:datasets": "bun run --filter @looker-bi-gym/app validate:datasets",
    "validate:manifests": "bun run --filter @looker-bi-gym/app validate:manifests",
    "validate:static-links": "bun run --filter @looker-bi-gym/app validate:static-links",
    "validate:terminology": "bun run --filter @looker-bi-gym/app validate:terminology",
    "validate:quiz-distractors": "bun run --filter @looker-bi-gym/app validate:quiz-distractors",
    "coverage:terminology": "bun run --filter @looker-bi-gym/app coverage:terminology",
    "coverage:cert-track": "bun run --filter @looker-bi-gym/app coverage:cert-track",
    "typecheck": "bun run --filter facts-db-app typecheck && bun run --filter @looker-bi-gym/app typecheck",
    "preview": "bun run --filter @looker-bi-gym/app preview"
  }
}
