    "test:progress-export": "pnpm --filter @looker-bi-gym/app test:progress-export",
    "test:content-qa": "pnpm --filter @looker-bi-gym/app test:content-qa",
    "test:validators": "pnpm --filter @looker-bi-gym/app test:validators",
    "validate:datasets": "pnpm --filter @looker-bi-gym/app validate:datasets",
